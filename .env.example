# App
APP_NAME="Itvaya Travel API"
APP_ENV="development"
DATABASE_URL="postgresql+asyncpg://user:password@localhost/itvaya"
API_V1_PREFIX="/api/v1"
SECRET_KEY="change_this_in_production_environment_with_strong_secret"

# Payment Provider ("mock" or "stripe" or "razorpay")
PAYMENT_PROVIDER="mock"
# Clerk Authentication
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay (Legacy)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Platform Financials
PLATFORM_COMMISSION_RATE=0.15

# Currency
DEFAULT_CURRENCY="INR"
SUPPORTED_CURRENCIES="INR,USD,EUR,GBP,AED,SGD,JPY"
CURRENCY_API_URL=""
CURRENCY_API_KEY=""

# Exponential Backoff Retries
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=10
RETRY_BACKOFF_MULTIPLIER=2
